###############################################################################
#  SwiftRoute — Last-Mile Delivery Tracker
#  Copy this file to `.env` and adjust.   ->   cp .env.example .env
#
#  EVERY variable below has a safe default. The application boots, seeds and
#  runs end-to-end with an empty .env — email/SMS simply fall back to the
#  in-app "Notification Outbox" instead of hitting a real provider.
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
#  CORE
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public URL of the API (used inside notification e-mails for tracking links)
API_PUBLIC_URL=http://localhost:4000

# Public URL of the React client (used for CORS + e-mail deep links)
WEB_PUBLIC_URL=http://localhost:5173

# Comma-separated list of extra origins allowed through CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173


# ─────────────────────────────────────────────────────────────────────────────
#  DATABASE
#  SQLite (default, zero-config):   file:./dev.db
#  PostgreSQL (production):         postgresql://user:pass@host:5432/swiftroute
#  The provider inside prisma/schema.prisma is auto-switched from this value.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"


# ─────────────────────────────────────────────────────────────────────────────
#  AUTHENTICATION
#  Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-a-different-long-random-string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10


# ─────────────────────────────────────────────────────────────────────────────
#  SEED DATA
#  Credentials created by `npm run db:seed`. Change before any public deploy.
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@swiftroute.dev
SEED_ADMIN_PASSWORD=Admin@123
SEED_DEMO_PASSWORD=Demo@123
# Set to "false" to skip the sample orders and keep only config + accounts.
SEED_DEMO_ORDERS=true


# ─────────────────────────────────────────────────────────────────────────────
#  E-MAIL NOTIFICATIONS
#  NOTIFY_EMAIL_PROVIDER = console | smtp
#
#  `console`  -> nothing leaves the machine. Messages are persisted to the
#                Notification table and visible in the in-app Outbox. This is
#                the default and is what the hosted demo runs on.
#  `smtp`     -> any SMTP server. Free options that work out of the box:
#                  • Brevo   smtp-relay.brevo.com:587      (300 mails/day free)
#                  • Mailtrap sandbox.smtp.mailtrap.io:2525 (safe test inbox)
#                  • Gmail   smtp.gmail.com:587 + App Password
# ─────────────────────────────────────────────────────────────────────────────
NOTIFY_EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=SwiftRoute
MAIL_FROM_ADDRESS=no-reply@swiftroute.dev


# ─────────────────────────────────────────────────────────────────────────────
#  SMS NOTIFICATIONS
#  NOTIFY_SMS_PROVIDER = console | twilio
#  Twilio's free trial gives you a number and credit for verified recipients.
# ─────────────────────────────────────────────────────────────────────────────
NOTIFY_SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ─────────────────────────────────────────────────────────────────────────────
#  AUTO-ASSIGNMENT ENGINE WEIGHTS
#  Tune how the nearest-available-agent score is composed. See
#  docs/AUTO_ASSIGNMENT.md for the full formula.
# ─────────────────────────────────────────────────────────────────────────────
# Kilometres beyond which a candidate scores 0 on proximity.
ASSIGN_MAX_DISTANCE_KM=25
# Relative importance of each signal (they are normalised, so only ratios matter)
ASSIGN_WEIGHT_DISTANCE=0.50
ASSIGN_WEIGHT_ZONE_MATCH=0.25
ASSIGN_WEIGHT_WORKLOAD=0.15
ASSIGN_WEIGHT_PERFORMANCE=0.10


# ─────────────────────────────────────────────────────────────────────────────
#  RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40


# ─────────────────────────────────────────────────────────────────────────────
#  FRONTEND (Vite) — only variables prefixed with VITE_ reach the browser
# ─────────────────────────────────────────────────────────────────────────────
# Leave empty to use the dev-server proxy / same-origin production build.
VITE_API_BASE_URL=
